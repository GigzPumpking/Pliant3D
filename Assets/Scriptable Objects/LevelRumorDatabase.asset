--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f09455097e7350349b44d09deda58a9f, type: 3}
  m_Name: LevelRumorDatabase
  m_EditorClassIdentifier: 
  rumors:
  - levelId: 1
    characterPicture: {fileID: 21300000, guid: 9e5555f539a5fab4f8a840b6f57de7af, type: 3}
    characterTitle:
      text: About Terry
      font: {fileID: 11400000, guid: 3638e27c03c6248f599d1acadf9d019c, type: 2}
      fontStyle: 32
      fontSize: 84
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterBioText:
      text: 'This office is big. I wonder if it''s just my desk or is it like that
        for everyone when they start?


        - Terry'
      font: {fileID: 11400000, guid: bb66502e09a8e4a2a9e45f54ef3ec893, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterBioImage: {fileID: 21300000, guid: 55b8b1f1a6643424eb3082f0632f8bea,
      type: 3}
    characterTipText:
      text: "Hmmm... I don't know about this new guy. He seems a little too fresh
        off the sticky pad if you ask me. Maybe he'll step up to the plate after
        taking on some more tasks. \n- Perry"
      font: {fileID: 11400000, guid: 2d914114cfced4a059d72767b54cab98, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: -20
      paragraphSpacing: 40
    characterTipImage: {fileID: 21300000, guid: fdc58578b11a24cb69cf15b7296a5ceb,
      type: 3}
    characterRumorText:
      text: "A new note came in! I'm excited for him to join us. I hope Perry doesn\u2019t
        scare him off. I left hints to get him started on the job since Perry isn't
        that good of an explainer.\n-Meri"
      font: {fileID: 11400000, guid: a9a314657bdb54275991278f37e78531, type: 2}
      fontStyle: 1
      fontSize: 52
      alignment: 257
      characterSpacing: -5
      wordSpacing: 0
      lineSpacing: -40
      paragraphSpacing: 60
    characterRumorImage: {fileID: 21300000, guid: a817c4e99289d4486a9572dc38712c82,
      type: 3}
  - levelId: 2
    characterPicture: {fileID: 21300000, guid: 11c32d7ba3ded304e8aea3a24edbc49b, type: 3}
    characterTitle:
      text: Here's What I Know
      font: {fileID: 11400000, guid: 3638e27c03c6248f599d1acadf9d019c, type: 2}
      fontStyle: 32
      fontSize: 84
      alignment: 0
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterBioText:
      text: 'Pliant will put you through origami to work here, but you have to be
        careful! You can only fold a paper so many times before it rips completely.


        -
        Meri'
      font: {fileID: 11400000, guid: a9a314657bdb54275991278f37e78531, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterBioImage: {fileID: 21300000, guid: a817c4e99289d4486a9572dc38712c82,
      type: 3}
    characterTipText:
      text: "Jerry runs on caffeine and leaves all his trash on his desk so be on
        the look out. But he\u2019s a hard worker and is grateful anytime he gets
        help\u2026 even if he doesn't tell you.\n\n- Meri"
      font: {fileID: 11400000, guid: a9a314657bdb54275991278f37e78531, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterTipImage: {fileID: 21300000, guid: a817c4e99289d4486a9572dc38712c82,
      type: 3}
    characterRumorText:
      text: "Carrie can get overwhelmed by a lot of the office work, so she doesn\u2019t
        always get everything done. She means well so I hope she doesn\u2019t run
        herself wrinkled, but time with her plants usually smoothes her out.\n\n-
        Meri"
      font: {fileID: 11400000, guid: a9a314657bdb54275991278f37e78531, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterRumorImage: {fileID: 21300000, guid: a817c4e99289d4486a9572dc38712c82,
      type: 3}
  - levelId: 3
    characterPicture: {fileID: 21300000, guid: 6ccf9d0e09ab8de45b6b5aee7490b81b, type: 3}
    characterTitle:
      text: How's Working with Jerry?
      font: {fileID: 11400000, guid: 3638e27c03c6248f599d1acadf9d019c, type: 2}
      fontStyle: 32
      fontSize: 84
      alignment: 0
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterBioText:
      text: 'If you ask me, they don''t pay us enough for this. I mean have you seen
        all the trash and empty cups on this desk! And don''t get me started on all
        the **COBWEBS**!


        - Jack'
      font: {fileID: 11400000, guid: bb66502e09a8e4a2a9e45f54ef3ec893, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterBioImage: {fileID: 21300000, guid: 3b08182a8db054bb59ec91400e6b057f,
      type: 3}
    characterTipText:
      text: "k so like, Jerry\u2019s like all bark and no bite. 1 time I was like,
        almost fired by Perry BUUUUT Jerry covered for me!! I owed him 1 soooo I\u2019m
        holding on 2 something 4 him shhhhh ;3\n\nxo, jane <3"
      font: {fileID: 11400000, guid: 670f66b393a16411c96719cf9442854f, type: 2}
      fontStyle: 8
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterTipImage: {fileID: 21300000, guid: 3b08182a8db054bb59ec91400e6b057f,
      type: 3}
    characterRumorText:
      text: "Bless his heart, but Jerry doesn\u2019t know up from down. I know we
        all get assigned our lovely **ROUTINES** (eyeroll), but hon, I am not a trash
        lady!\n\n~ Jenisis"
      font: {fileID: 11400000, guid: 670f66b393a16411c96719cf9442854f, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterRumorImage: {fileID: 21300000, guid: 3b08182a8db054bb59ec91400e6b057f,
      type: 3}
  - levelId: 4
    characterPicture: {fileID: 21300000, guid: 98d7c7e19a6105d46bc3a0c517c82d19, type: 3}
    characterTitle:
      text: What Goes on Here?
      font: {fileID: 11400000, guid: 3638e27c03c6248f599d1acadf9d019c, type: 2}
      fontStyle: 32
      fontSize: 84
      alignment: 0
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterBioText:
      text: "Don\u2019t tell anyone\u2026 but I\u2019m not quite sure what we do
        in this office. My resume was complete rubbish, but since I\u2019m from the
        UK I don\u2019t think they ever bothered checking!\n\nCherry"
      font: {fileID: 11400000, guid: 76bf3b390ca364507b7776e19a76b0f0, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterBioImage: {fileID: 21300000, guid: 272c26b89ef1c4c8fb6a8db0cc08fb81,
      type: 3}
    characterTipText:
      text: "People say I talk about surfing too much BUT when you\u2019re a 15x
        time surfing champ, you do what you want! Dang where are my lucky **SHADES**??\n\nChandlerrr!"
      font: {fileID: 11400000, guid: 695268b83296c47229d2cb8a423b99bf, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterTipImage: {fileID: 21300000, guid: 272c26b89ef1c4c8fb6a8db0cc08fb81,
      type: 3}
    characterRumorText:
      text: "Name?\u2026 my name is ~~Charles~~ Chip\nDo I write here for rumors?\n"
      font: {fileID: 11400000, guid: 670f66b393a16411c96719cf9442854f, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterRumorImage: {fileID: 21300000, guid: 272c26b89ef1c4c8fb6a8db0cc08fb81,
      type: 3}
  - levelId: 5
    characterPicture: {fileID: 21300000, guid: 79eec8d47ac33244da843ad0cd36c02f, type: 3}
    characterTitle:
      text: Sooo...Perry
      font: {fileID: 11400000, guid: 3638e27c03c6248f599d1acadf9d019c, type: 2}
      fontStyle: 32
      fontSize: 84
      alignment: 0
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterBioText:
      text: "This is anonymous right? I hate my father! You know, for my 10th birthday,
        he got me an iPad 4 instead of an iPad 4 Pro Max Deluxe. That\u2019s the
        kind of post-it he is.\nSincerley,\nPercy"
      font: {fileID: 11400000, guid: bb66502e09a8e4a2a9e45f54ef3ec893, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterBioImage: {fileID: 21300000, guid: fdc58578b11a24cb69cf15b7296a5ceb,
      type: 3}
    characterTipText:
      text: "Yeaaaaaahh so like I\u2019m kinda the post-it to talk to when it comes
        to **ROUTINES** around here. I can work under any condition and you\u2019ll
        never hear me complain!\n\n- Payton"
      font: {fileID: 11400000, guid: bb66502e09a8e4a2a9e45f54ef3ec893, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterTipImage: {fileID: 21300000, guid: fdc58578b11a24cb69cf15b7296a5ceb,
      type: 3}
    characterRumorText:
      text: "Perry is by far the worst boss I\u2019ve ever had. I have no idea how
        he got to where he is. Maybe I can get a transfer to another desk, I\u2019d
        love to work for Meri. Now that\u2019s a good boss.\n\nPenny!"
      font: {fileID: 11400000, guid: bb66502e09a8e4a2a9e45f54ef3ec893, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterRumorImage: {fileID: 21300000, guid: fdc58578b11a24cb69cf15b7296a5ceb,
      type: 3}
  - levelId: 6
    characterPicture: {fileID: 21300000, guid: 9e5555f539a5fab4f8a840b6f57de7af, type: 3}
    characterTitle:
      text: Week Wrap Up!
      font: {fileID: 11400000, guid: 3638e27c03c6248f599d1acadf9d019c, type: 2}
      fontStyle: 32
      fontSize: 84
      alignment: 0
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterBioText:
      text: "What a week. I wonder if every day is this exhausting. At least it's
        Friday, although I don't know if I'll have a job next week\u2026working sucks.\n\n-
        Terry"
      font: {fileID: 11400000, guid: bb66502e09a8e4a2a9e45f54ef3ec893, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterBioImage: {fileID: 21300000, guid: 55b8b1f1a6643424eb3082f0632f8bea,
      type: 3}
    characterTipText:
      text: 'You got a lot accomplished this week so I hope you are proud of yourself
        regardless of the outcome. Get some rest and I hope to see you on Monday!


        -
        Meri'
      font: {fileID: 11400000, guid: 2d914114cfced4a059d72767b54cab98, type: 2}
      fontStyle: 0
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterTipImage: {fileID: 21300000, guid: fdc58578b11a24cb69cf15b7296a5ceb,
      type: 3}
    characterRumorText:
      text: "I guess\u2026 thanks for the help. We probably could have done it without
        you but I appreciate you taking some weight off my adhesive.\n\nJerry"
      font: {fileID: 11400000, guid: a9a314657bdb54275991278f37e78531, type: 2}
      fontStyle: 1
      fontSize: 48
      alignment: 257
      characterSpacing: 0
      wordSpacing: 0
      lineSpacing: 0
      paragraphSpacing: 0
    characterRumorImage: {fileID: 21300000, guid: a817c4e99289d4486a9572dc38712c82,
      type: 3}
